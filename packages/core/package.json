{
  "name": "@changebot/core",
  "version": "0.4.1",
  "description": "Changebot widgets - Stencil web components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/widgets/widgets.esm.js",
  "exports": {
    ".": {
      "import": "./dist/widgets/widgets.esm.js",
      "require": "./dist/widgets/widgets.cjs.js"
    },
    "./dist/components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./dist/components/changebot-badge.js": {
      "import": "./dist/components/changebot-badge.js",
      "types": "./dist/components/changebot-badge.d.ts"
    },
    "./dist/components/changebot-banner.js": {
      "import": "./dist/components/changebot-banner.js",
      "types": "./dist/components/changebot-banner.d.ts"
    },
    "./dist/components/changebot-panel.js": {
      "import": "./dist/components/changebot-panel.js",
      "types": "./dist/components/changebot-panel.d.ts"
    },
    "./dist/components/changebot-provider.js": {
      "import": "./dist/components/changebot-provider.js",
      "types": "./dist/components/changebot-provider.d.ts"
    },
    "./dist/components/changebot-toast.js": {
      "import": "./dist/components/changebot-toast.js",
      "types": "./dist/components/changebot-toast.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/changebot-ai/widgets.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "pnpm run test.spec && pnpm run test.e2e",
    "test.spec": "vitest run --project spec",
    "test.e2e": "playwright test",
    "test.watch": "vitest --project spec",
    "test.smoke": "node scripts/smoke-test.mjs",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stencil/core": "^4.44.1",
    "@stencil/playwright": "^0.5.1",
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/vitest": "^1.15.0",
    "@stencil/vue-output-target": "^0.14.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@stencil/store": "^2.2.4",
    "canvas-confetti": "^1.9.3"
  }
}
